{
  "name": "gains",
  "version": "0.0.15",
  "description": "All in one tools to help strength athletes load the right amount of training dosage!",
  "keywords": [
    "bench",
    "bodybuilding",
    "deadlift",
    "fitness",
    "gains",
    "powerlifting",
    "press",
    "squat",
    "workout"
  ],
  "homepage": "https://github.com/wajeht/gains#readme",
  "bugs": {
    "url": "https://github.com/wajeht/gains/issues"
  },
  "license": "MIT",
  "author": {
    "name": "wajeht",
    "url": "https://jaw.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wajeht/gains.git"
  },
  "type": "module",
  "main": "./src/server.js",
  "scripts": {
    "start": "node ./src/server.js",
    "build:start": "npm run build && node ./src/server.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "update:deps": " npx npm-check -u",
    "check:deps": "npx depcheck",
    "dev": "concurrently -n \"VUE,EXPRESS\" -c \"#42b883,#68a063\" \"vite --port 3000\" \"nodemon ./src/server.js\"",
    "dev:ui": "vite",
    "dev:api": "nodemon ./src/server.js",
    "dev:hmr": "concurrently --kill-others --names \"EXPRESS,VUE\" -c \"bgGreen.black,bgRed.black\" \"HMR='true' nodemon ./src/server.js\" \"open-cli http://localhost:3000/ && vite\"",
    "build": "npm run build:ui && npm run build:api && npm run minify:html",
    "build:ui": "vite build",
    "build:api": "echo api does not need to build!",
    "migrate:make": "knex migrate:make --knexfile=./src/config/knexfile.js",
    "migrate:latest": "knex migrate:latest --knexfile=./src/config/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile=./src/config/knexfile.js",
    "seed:run": "knex seed:run --knexfile=./src/config/knexfile.js",
    "reset:db": "npm run migrate:rollback && npm run migrate:latest",
    "rmds": "find . -name '.DS_Store' -delete",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write . > /dev/null",
    "minify:html": "html-minifier-terser --input-dir ./src --output-dir ./src --collapse-whitespace --minify-js --minify-css --remove-comments --file-ext html"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.8.2",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.0.6",
    "@popperjs/core": "^2.11.8",
    "@vitejs/plugin-vue": "^6.0.3",
    "adm-zip": "^0.6.0",
    "animate.css": "^4.1.1",
    "better-sqlite3": "^12.6.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.5.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "googleapis": "^170.0.0",
    "helmet": "^7.1.0",
    "html-minifier-terser": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "knex-paginate": "^3.1.2",
    "lodash-es": "^4.17.21",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "papaparse": "^5.4.1",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "request-ip": "^3.3.0",
    "uuid": "^13.0.0",
    "vite": "^7.3.1",
    "vue": "^3.4.25",
    "vue-chart-3": "^4.0.1",
    "vue-query": "^1.26.0",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@vitest/coverage-v8": "^4.0.16",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.0",
    "oxfmt": "^0.23.0",
    "postcss": "^8.4.38",
    "sass": "^1.75.0",
    "vitest": "^4.0.16"
  }
}
